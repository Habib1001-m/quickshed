  "scripts": {
    "dev": "next dev -p 7125",
    "build": "next build",
    "start": "next start -p 7125",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test --project=chromium --project=mobile-chromium",
