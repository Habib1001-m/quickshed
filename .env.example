# =============================================================================
# QuickShed — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values for local development.
# For production, set these in your Vercel project settings.
# =============================================================================

# Site URL (no trailing slash)
# Local:      http://localhost:3000
# Production: https://quickshed.com (or your custom domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (optional — only needed if using Prisma features)
# DATABASE_URL=file:./db/custom.db
